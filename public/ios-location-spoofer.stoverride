name: iOS Location Spoofer (Stateless)
desc: "任何售卖本项目/模块的都是骗子，请立即联系退款。通用脚本兼容修复 20261101.1，保留原定位响应字段，异常时原样放行。Stash，真机效果未验证。"
homepage: https://cyberhandyman-ioslocspo.cyberhandyman.workers.dev

http:
  mitm:
    - "gs-loc.apple.com"
    - "gs-loc-cn.apple.com"
  script:
    - match: ^https?:\/\/gs-loc(-cn)?\.apple\.com\/clls\/wloc
      name: ios-location-spoofer
      type: response
      require-body: true
      binary-mode: true
      max-size: 0
      timeout: 30
      argument: mode=response&debug=false
    - match: ^https?:\/\/gs-loc(-cn)?\.apple\.com\/ils-settings\/
      name: ios-location-settings
      type: request
      require-body: false
      timeout: 10

script-providers:
  ios-location-spoofer:
    url: https://cyberhandyman-ioslocspo.cyberhandyman.workers.dev/location-spoofer.js?v=20261101.1
    interval: 86400
  ios-location-settings:
    url: https://cyberhandyman-ioslocspo.cyberhandyman.workers.dev/location-settings.js?v=20261101.1
    interval: 86400
